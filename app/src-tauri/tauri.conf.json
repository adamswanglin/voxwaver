{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoxWeaver",
  "version": "0.1.0",
  "identifier": "com.voxwaver.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/audio/**", "$APPDATA/voices/**", "$APPDATA/samples/**", "$HOME/**"]
      },
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis", "appimage", "deb"],
    "macOS": {
      "infoPlist": "Info.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
